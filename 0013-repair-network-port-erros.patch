diff --git a/package/utils/busybox/files/sysntpd b/package/utils/busybox/files/sysntpd
index 0d291f2b..6624161e 100644
--- a/package/utils/busybox/files/sysntpd
+++ b/package/utils/busybox/files/sysntpd
@@ -6,6 +6,8 @@ START=98
 USE_PROCD=1
 PROG=/usr/sbin/ntpd
 HOTPLUG_SCRIPT=/usr/sbin/ntpd-hotplug
+# Wrapper to silence ntpd output (redirect stderr to null)
+NTPD_WRAPPER="/tmp/ntpd_wrapper.sh"
 
 get_dhcp_ntp_servers() {
 	local interfaces="$1"
@@ -40,6 +42,7 @@ validate_ntp_section() {
 
 start_ntpd_instance() {
 	local peer
+	local ntpd_args=""
 
 	[ "$2" = 0 ] || {
 		echo "validation failed"
@@ -52,23 +55,36 @@ start_ntpd_instance() {
 
 	[ -z "$server" -a "$enable_server" = "0" ] && return
 
-	procd_open_instance
-	procd_set_param command "$PROG" -n -N
+	# Build ntpd arguments
+	ntpd_args="-n -N"
 	if [ "$enable_server" = "1" ]; then
-		procd_append_param command -l
+		ntpd_args="$ntpd_args -l"
 		[ -n "$interface" ] && {
 			local ifname
-
 			network_get_device ifname "$interface" || \
 				ifname="$interface"
-			procd_append_param command -I "$ifname"
-			procd_append_param netdev "$ifname"
+			ntpd_args="$ntpd_args -I $ifname"
 		}
 	fi
