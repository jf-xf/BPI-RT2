+
+	# Create wrapper script to redirect stderr to /dev/null
+	cat > "$NTPD_WRAPPER" << EOF
+#!/bin/sh
+exec $PROG $ntpd_args 2>/dev/null
+EOF
+	chmod +x "$NTPD_WRAPPER"
+
+	procd_open_instance
+	procd_set_param command "$NTPD_WRAPPER"
+	[ -n "$interface" ] && [ "$enable_server" = "1" ] && {
+		local ifname
+		network_get_device ifname "$interface" || ifname="$interface"
+		procd_append_param netdev "$ifname"
+	}
 	procd_set_param respawn
 	[ -x /sbin/ujail -a -e /etc/capabilities/ntpd.json ] && {
 		procd_add_jail ntpd ubus
