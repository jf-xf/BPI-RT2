 	//ifname, ifflag, vid, phyPort, dev_instant
 	{"eth0",		RTL8686_ELAN, 0, CPU_PORT0, 0, NULL}, // root dev eth0 must be first
-	{"eth0.2",		RTL8686_ELAN, 0, LAN_PORT1, 1, NULL},
+	{"eth0.2",		RTL8686_WAN, 0, LAN_PORT1, 1, NULL},
 	{"eth0.3",		RTL8686_ELAN, 0, LAN_PORT2, 1, NULL},
 	{"eth0.4",		RTL8686_ELAN, 0, LAN_PORT3, 1, NULL},
 	{"eth0.5",		RTL8686_ELAN, 0, LAN_PORT4, 1, NULL},
@@ -816,7 +816,7 @@ static intrBcasterNotifier_t GMAClinkChangeNotifier = {
     .notifierCb = gmacintr_notifier_link_change,
 };
 
-#if defined(CONFIG_ETHWAN_USE_USB_SGMII) || defined(CONFIG_ETHWAN_USE_PCIE1_SGMII)
+#if defined(CONFIG_ETHWAN_USE_USB_SGMII) || defined(CONFIG_ETHWAN_USE_PCIE1_SGMII) || defined(CONFIG_ETHWAN_USE_LAN_PORT1)
 static void gmacintr_notifier_ethwan_link_change(intrBcasterMsg_t	*pMsgData)
 {
 #if 0
@@ -12416,7 +12416,7 @@ static int rtk_gmac_multi_lan_device_init(void)
 	{
 		printk(KERN_CONT "Interrupt Broadcaster for Link Change Error !! \n");
 	}
-#if defined(CONFIG_ETHWAN_USE_USB_SGMII) || defined(CONFIG_ETHWAN_USE_PCIE1_SGMII)
+#if defined(CONFIG_ETHWAN_USE_USB_SGMII) || defined(CONFIG_ETHWAN_USE_PCIE1_SGMII) || defined(CONFIG_ETHWAN_USE_LAN_PORT1)
 	if(intr_bcaster_notifier_cb_register(&GMACethwanStateChangeNotifier) != 0)
 	{
 		printk(KERN_CONT "Interrupt Broadcaster for ether WAN Link Change Error !! \n");
diff --git a/rtk_openwrt/target/linux/realtek_bb/files-5.10/drivers/net/ethernet/realtek/rtl86900/nicDriver/re8686_rtl9607c.h b/rtk_openwrt/target/linux/realtek_bb/files-5.10/drivers/net/ethernet/realtek/rtl86900/nicDriver/re8686_rtl9607c.h
index a0b0fa0e..c194d332 100755
--- a/rtk_openwrt/target/linux/realtek_bb/files-5.10/drivers/net/ethernet/realtek/rtl86900/nicDriver/re8686_rtl9607c.h
+++ b/rtk_openwrt/target/linux/realtek_bb/files-5.10/drivers/net/ethernet/realtek/rtl86900/nicDriver/re8686_rtl9607c.h
@@ -186,21 +186,33 @@ enum {
 #define WAN_PORT 				APOLLOPRO_SGMII0_PORT
 #elif defined(CONFIG_ETHWAN_USE_PCIE1_SGMII)
 #define WAN_PORT 				APOLLOPRO_SGMII1_PORT
+#elif defined(CONFIG_ETHWAN_USE_LAN_PORT1)
+#define WAN_PORT 				LAN_PORT1
 #else
 #define WAN_PORT 				APOLLOPRO_PON_PORT
 #endif
 #define MAX_PON_PORT		1
 //#define IS_CPU_PORT(port)	(port==CPU_PORT0||port==CPU_PORT1||port==CPU_PORT2)
 #if defined(CONFIG_RTK_SOC_RTL8198D)
+#if defined(CONFIG_ETHWAN_USE_LAN_PORT1)
+#define MAX_LAN_PORT		8
+#else
 #define MAX_LAN_PORT		9
+#endif
 /*
  * Note: IS_LAN_PORT() macro is used in gmacintr_notifier_link_change() function only,
  *   if IS_LAN_PORT() return false, gmacintr_notifier_link_change() will do nothing,
  *   if IS_LAN_PORT() return true, gmacintr_notifier_link_change() will do carrier on or carrier off of network interface
  *   depend on link up or link down of Link Change Interrupt status.
+ *   When CONFIG_ETHWAN_USE_LAN_PORT1 is defined, LAN_PORT1 is used as WAN, so exclude it from IS_LAN_PORT.
  */
+#if defined(CONFIG_ETHWAN_USE_LAN_PORT1)
+#define IS_LAN_PORT(port)	(port==(u32)LAN_PORT2||port==(u32)LAN_PORT3||port==(u32)LAN_PORT4||port==(u32)LAN_PORT5\
+		||port==(u32)LAN_PORT6||port==(u32)APOLLOPRO_SGMII0_PORT||port==(u32)APOLLOPRO_SGMII1_PORT||port==(u32)APOLLOPRO_PON_PORT)
+#else
 #define IS_LAN_PORT(port)	(port==(u32)LAN_PORT1||port==(u32)LAN_PORT2||port==(u32)LAN_PORT3||port==(u32)LAN_PORT4||port==(u32)LAN_PORT5\
 		||port==(u32)LAN_PORT6||port==(u32)APOLLOPRO_SGMII0_PORT||port==(u32)APOLLOPRO_SGMII1_PORT||port==(u32)APOLLOPRO_PON_PORT)
+#endif
 #elif !defined(CONFIG_ETHWAN_USE_USB_SGMII) && !defined(CONFIG_ETHWAN_USE_PCIE1_SGMII)
 #define MAX_LAN_PORT		8
 #define IS_LAN_PORT(port)	(port==LAN_PORT1||port==LAN_PORT2||port==LAN_PORT3||port==LAN_PORT4||port==LAN_PORT5||port==LAN_PORT6||port==APOLLOPRO_SGMII0_PORT||port==APOLLOPRO_SGMII1_PORT)
