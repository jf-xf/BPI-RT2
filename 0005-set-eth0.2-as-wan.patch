diff --git a/rtk_openwrt/package/realtek/rtk_base/files/gen_interface_config.sh b/rtk_openwrt/package/realtek/rtk_base/files/gen_interface_config.sh
index e66cc8e4..22807701 100755
--- a/rtk_openwrt/package/realtek/rtk_base/files/gen_interface_config.sh
+++ b/rtk_openwrt/package/realtek/rtk_base/files/gen_interface_config.sh
@@ -14,9 +14,9 @@ NIC_NUM=1
 NIC_PREFIX="eth"
 NIC_IDX=0
 
-LAN_NUM=4
+LAN_NUM=3
 LAN_PREFIX="eth0."
-LAN_IDX=2
+LAN_IDX=3
 
 WAN_NUM=1
 WAN_PREFIX="nas"
diff --git a/rtk_openwrt/target/linux/realtek_bb/base-files/etc/board.d/02_network b/rtk_openwrt/target/linux/realtek_bb/base-files/etc/board.d/02_network
index 8d6d71c4..6dd388c7 100755
--- a/rtk_openwrt/target/linux/realtek_bb/base-files/etc/board.d/02_network
+++ b/rtk_openwrt/target/linux/realtek_bb/base-files/etc/board.d/02_network
@@ -16,10 +16,15 @@ case "$(board_name)" in
 esac
 
 if [ "${INTF_LAN_LISTS}" = "" ]; then 
-	INTF_LAN_LISTS="eth0.2 eth0.3 eth0.4 eth0.5"
+	INTF_LAN_LISTS="eth0.3 eth0.4 eth0.5"
+fi
+
+if [ "${INTF_WAN_LISTS}" = "" ]; then
+	INTF_WAN_LISTS="eth0.2"
 fi
 
 ucidef_set_interface_lan "${INTF_LAN_LISTS}"
+ucidef_set_interface_wan "${INTF_WAN_LISTS}" "dhcp"
 
 board_config_flush
 
diff --git a/rtk_openwrt/target/linux/realtek_bb/files-5.10/drivers/net/ethernet/realtek/Kconfig b/rtk_openwrt/target/linux/realtek_bb/files-5.10/drivers/net/ethernet/realtek/Kconfig
index 82459814..08ebb3a9 100755
