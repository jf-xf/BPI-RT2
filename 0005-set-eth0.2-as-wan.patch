+++ b/rtk_openwrt/target/linux/realtek_bb/files-5.10/drivers/net/ethernet/realtek/Kconfig
@@ -427,6 +427,13 @@ config ETHWAN
 	help
 	ETH_WAN setting
 
+config ETHWAN_USE_LAN_PORT1
+	bool "Use LAN Port1 as WAN Port"
+	default n
+	depends on ETHWAN
+	help
+	Use LAN_PORT1 (port0) as WAN port instead of PON port
+
 config AUTO_DHCP_CHECK
 	bool "Auto DHCP Check"
 	default n
diff --git a/rtk_openwrt/target/linux/realtek_bb/files-5.10/drivers/net/ethernet/realtek/rtl86900/nicDriver/re8686_rtl9607c.c b/rtk_openwrt/target/linux/realtek_bb/files-5.10/drivers/net/ethernet/realtek/rtl86900/nicDriver/re8686_rtl9607c.c
