From 85cf5e666b732b6e00b48a691c9c9a0f64e9c30b Mon Sep 17 00:00:00 2001
From: Qubot <1445788683@qq.com>
Date: Tue, 27 Jan 2026 17:54:32 +0800
Subject: [PATCH 08/12] fix env bug

---
 .../rtk_base/files/gen_rtk_script_env.sh      | 28 +++++++++----------
 1 file changed, 14 insertions(+), 14 deletions(-)

diff --git a/rtk_openwrt/package/realtek/rtk_base/files/gen_rtk_script_env.sh b/rtk_openwrt/package/realtek/rtk_base/files/gen_rtk_script_env.sh
index 8494990c..75f627a2 100755
--- a/rtk_openwrt/package/realtek/rtk_base/files/gen_rtk_script_env.sh
+++ b/rtk_openwrt/package/realtek/rtk_base/files/gen_rtk_script_env.sh
@@ -7,24 +7,24 @@ iproute_file=$(pwd)/src/iproute_define.h
 # clear output file
 : > $filename
 
-echo -e "#!/bin/sh" >> $filename
-echo -e "##########################" >> $filename
-echo -e "# Automatically generated by rtk_base package: don't edit" >> $filename
-echo -e "# Provide other shell script source it." >> $filename
-echo -e "##########################" >> $filename
-echo -e "\n\n" >> $filename
+echo  "#!/bin/sh" >> $filename
+echo  "##########################" >> $filename
+echo  "# Automatically generated by rtk_base package: don't edit" >> $filename
+echo  "# Provide other shell script source it." >> $filename
+echo  "##########################" >> $filename
+echo  "\n\n" >> $filename
 
-echo -e "##########################" >> $filename
-echo -e "# define ip route infomation from $(basename $iproute_file)" >> $filename
-echo -e "##########################" >> $filename
+echo  "##########################" >> $filename
+echo  "# define ip route infomation from $(basename $iproute_file)" >> $filename
+echo  "##########################" >> $filename
 #awk -F' ' '($1~/^#define/) && ($2~/.*_RTL_TBL/) {print $2"="$3}' $iproute_file >> $filename
 awk -F' ' '($1~/^#define/) && ($2~/^.*_RT_TBL/) {print $2"="$3}' $iproute_file >> $filename
-echo -e "\n\n" >> $filename
+echo  "\n\n" >> $filename
 awk -F' ' '($1~/^#define/) && ($2~/^RULE_PRI_.*/) {print $2"="$3}' $iproute_file >> $filename
 
 
-echo -e "\n" >> $filename
-echo -e "##########################" >> $filename
-echo -e "# define skb mark infomation from $(basename $skbmark_file)" >> $filename
-echo -e "##########################" >> $filename
+echo  "\n" >> $filename
+echo  "##########################" >> $filename
+echo  "# define skb mark infomation from $(basename $skbmark_file)" >> $filename
+echo  "##########################" >> $filename
 awk -F' ' '($1~/^#define/) && ($2~/^SOCK_MARK.*_START|END/) {print $2"="$3}' $skbmark_file >> $filename
-- 
