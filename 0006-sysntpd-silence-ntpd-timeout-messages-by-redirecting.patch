From 7bce8a61e94c509d05948347770ba0f404ce8004 Mon Sep 17 00:00:00 2001
From: Qubot <1445788683@qq.com>
Date: Tue, 27 Jan 2026 15:06:30 +0800
Subject: [PATCH 06/12] sysntpd: silence ntpd timeout messages by redirecting
 stderr to /dev/null

---
 package/utils/busybox/files/sysntpd | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/package/utils/busybox/files/sysntpd b/package/utils/busybox/files/sysntpd
index 074f14b8..0d291f2b 100755
--- a/package/utils/busybox/files/sysntpd
+++ b/package/utils/busybox/files/sysntpd
@@ -82,6 +82,8 @@ start_ntpd_instance() {
 		procd_set_param group ntp
 		procd_set_param no_new_privs 1
 	}
+	procd_set_param stdout 0
+	procd_set_param stderr 0
 	procd_close_instance
 }
 
